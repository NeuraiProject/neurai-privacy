{
  "name": "@neuraiproject/neurai-privacy",
  "version": "0.1.1",
  "description": "Private XNA payments on Neurai: private wallets from the wallet words, nzk addresses and zero-knowledge proofs built on the device",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuraiProject/neurai-privacy.git"
  },
  "bugs": {
    "url": "https://github.com/NeuraiProject/neurai-privacy/issues"
  },
  "homepage": "https://github.com/NeuraiProject/neurai-privacy#readme",
  "keywords": [
    "neurai",
    "privacy",
    "zero-knowledge",
    "wallet",
    "xna"
  ],
  "author": "Neurai Project",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:types": "tsc -p tsconfig.json",
    "test:build": "node scripts/check-build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run test:types && npm run test:build"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "peerDependencies": {
    "@neuraiproject/neurai-rpc": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@neuraiproject/neurai-rpc": {
      "optional": true
    }
  }
}
